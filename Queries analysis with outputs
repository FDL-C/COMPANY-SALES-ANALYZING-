### Query 6 — Top 3 Selling Products by City

```sql
WITH ranked AS (
    SELECT 
        c.city_name,
        p.product_name,
        COUNT(s.sale_id) AS units_sold,
        ROW_NUMBER() OVER (
            PARTITION BY c.city_id 
            ORDER BY COUNT(s.sale_id) DESC
        ) AS rn
    FROM sales s
    JOIN customers cu ON s.customer_id = cu.customer_id
    JOIN city c       ON cu.city_id = c.city_id
    JOIN products p   ON s.product_id = p.product_id
    GROUP BY c.city_id, c.city_name, p.product_id, p.product_name
)
SELECT city_name, rn AS rank, product_name, units_sold
FROM ranked
WHERE rn <= 3
ORDER BY city_name, rn;
