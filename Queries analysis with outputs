### Query 9 — Monthly Sales Growth

```sql
WITH monthly AS (
    SELECT 
        STRFTIME('%Y-%m', sale_date) AS month,
        SUM(CAST(total AS INTEGER))   AS monthly_revenue
    FROM sales
    GROUP BY month
),
growth AS (
    SELECT 
        month,
        monthly_revenue,
        LAG(monthly_revenue) OVER (ORDER BY month) AS prev_month_revenue
    FROM monthly
)
SELECT 
    month,
    monthly_revenue,
    prev_month_revenue,
    CASE WHEN prev_month_revenue IS NULL THEN NULL
         ELSE ROUND((monthly_revenue - prev_month_revenue) * 100.0 
                    / prev_month_revenue, 2)
    END AS growth_rate_pct
FROM growth
ORDER BY month;
```

