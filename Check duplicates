SELECT '=== 2A-4: Duplicate sale_id in sales ===' AS check_name;
SELECT sale_id, COUNT(*) AS cnt
FROM sales 
GROUP BY sale_id 
HAVING cnt > 1;
SELECT 'No duplicates found' AS result WHERE NOT EXISTS (
    SELECT 1 FROM sales GROUP BY sale_id HAVING COUNT(*)>1);

SELECT '=== 2A-5: Fully duplicate rows in sales ===' AS check_name;
SELECT sale_date, product_id, customer_id, total, rating,
       COUNT(*) AS cnt
FROM sales
GROUP BY sale_date, product_id, customer_id, total, rating
HAVING cnt > 1
LIMIT 10;
SELECT 'No fully duplicate rows' AS result WHERE NOT EXISTS (
    SELECT 1 FROM sales
    GROUP BY sale_date, product_id, customer_id, total, rating
    HAVING COUNT(*)>1);

