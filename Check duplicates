-- ---- 2A: CHECK DUPLICATES ----

SELECT '=== 2A-1: Duplicate city_id in city ===' AS check_name;
SELECT city_id, COUNT(*) AS cnt
FROM city
GROUP BY city_id 
HAVING cnt > 1;
SELECT 'No duplicates found' AS result WHERE NOT EXISTS (
    SELECT 1 FROM city GROUP BY city_id HAVING COUNT(*)>1);

